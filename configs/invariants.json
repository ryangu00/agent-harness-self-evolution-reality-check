{
  "knobs": [
    {"name": "default_threshold", "file": "limits.conf", "regex": "^THRESHOLD = (\\d+)", "env": "HARNESS_TRIGGER_THRESHOLD"},
    {"name": "resource_threshold", "file": "limits.conf", "regex": "^RESOURCE = (\\d+)"}
